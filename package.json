{
  "name": "crownsmm-php-panel",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "sh -c 'if ! service mariadb status >/dev/null 2>&1; then service mariadb start >/dev/null 2>&1 || true; fi; exec php -S 0.0.0.0:3000 preview-router.php' --",
    "build": "find . -maxdepth 5 -name '*.php' -not -path './preview-router.php' -not -path './node_modules/*' -print0 | xargs -0 -n1 php -l >/dev/null",
    "lint": "find . -maxdepth 5 -name '*.php' -not -path './preview-router.php' -not -path './node_modules/*' -print0 | xargs -0 -n1 php -l >/dev/null"
  },
  "dependencies": {},
  "devDependencies": {}
}
