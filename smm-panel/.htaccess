Options -Indexes
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct web access to sensitive folders and files
    RewriteRule ^(config|database|storage|classes|includes)/ - [F,L]
    RewriteRule ^(\.env|composer\.|package\.json|README\.md) - [F,L]
</IfModule>

<FilesMatch "\.(sql|log|lock|ini|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
